
import { useEffect, useState } from 'react'
import { Plus, Sparkles, LogOut, RefreshCw } from 'lucide-react'

import Sidebar from './components/Sidebar'
import Topbar from './components/Topbar'
import StatCard from './components/StatCard'
import SalesChart from './components/SalesChart'
import LeadQualification from './components/LeadQualification'
import LeadTable from './components/LeadTable'
import Login from './components/Login'
import FollowUps from './components/FollowUps'
import AIConversations from './components/AIConversations'
import AIAssistant from './components/AIAssistant'
import Quotations from './components/Quotations'
import Appointments from './components/Appointments'
import Reports from './components/Reports'
import Settings from './components/Settings'

import { getCurrentUser, getLeads } from './services/api'

function LoadingScreen() {
  return (
    <div className="flex min-h-screen items-center justify-center bg-[#090d16]">
      <div className="text-center">
        <div className="mx-auto h-10 w-10 animate-spin rounded-full border-2 border-violet-400/20 border-t-violet-400" />
        <p className="mt-4 text-sm text-slate-400">
          Preparing your workspace...
        </p>
      </div>
    </div>
  )
}

function ErrorMessage({ message, onRetry }) {
  if (!message) return null

  return (
    <div className="mb-5 flex flex-col gap-3 rounded-xl border border-rose-400/20 bg-rose-400/[0.06] p-4 sm:flex-row sm:items-center sm:justify-between">
      <p className="text-sm text-rose-200">{message}</p>
      <button
        type="button"
        onClick={onRetry}
        className="inline-flex items-center justify-center gap-2 rounded-lg border border-rose-400/20 px-3 py-2 text-xs text-rose-200 transition hover:bg-rose-400/10"
      >
        <RefreshCw size={14} />
        Try again
      </button>
    </div>
  )
}

export default function App() {
  // Keep password-reset links separate from the normal login session.
  const isPasswordResetPage =
    window.location.pathname.endsWith('/reset-password')

  const [user, setUser] = useState(null)
  const [authLoading, setAuthLoading] = useState(true)

  const [activePage, setActivePage] = useState('Overview')
  const [mobileMenu, setMobileMenu] = useState(false)
  const [query, setQuery] = useState('')
  const [filter, setFilter] = useState('All')

  const [leads, setLeads] = useState([])
  const [leadsLoading, setLeadsLoading] = useState(false)
  const [leadsError, setLeadsError] = useState('')
  const [refreshKey, setRefreshKey] = useState(0)
  const [globalRefreshKey, setGlobalRefreshKey] = useState(0)

  useEffect(() => {
    // Password reset should not depend on an existing login session.
    if (isPasswordResetPage) {
      setAuthLoading(false)
      return
    }

    let cancelled = false

    async function checkSession() {
      const token = localStorage.getItem('access_token')

      if (!token) {
        setAuthLoading(false)
        return
      }

      try {
        const currentUser = await getCurrentUser()

        if (!cancelled) {
          setUser(currentUser)
        }
      } catch {
        localStorage.removeItem('access_token')
        localStorage.removeItem('refresh_token')

        if (!cancelled) {
          setUser(null)
        }
      } finally {
        if (!cancelled) {
          setAuthLoading(false)
        }
      }
    }

    checkSession()

    return () => {
      cancelled = true
    }
  }, [isPasswordResetPage])

  useEffect(() => {
    if (!user || isPasswordResetPage) {
      setLeads([])
      return
    }

    let cancelled = false

    async function loadLeads() {
      setLeadsLoading(true)
      setLeadsError('')

      try {
        const data = await getLeads()
        const items = Array.isArray(data)
          ? data
          : Array.isArray(data?.results)
            ? data.results
            : []

        const mappedLeads = items.map((lead) => {
          const name = lead.name || 'Unnamed lead'
          const priority = String(lead.priority || 'WARM').toUpperCase()
          const pipelineStatus = String(lead.status || 'NEW').toUpperCase()

          return {
            ...lead,
            name,
            company: lead.company || 'â€”',
            email: lead.email || 'â€”',
            phone: lead.phone || 'â€”',
            source: String(lead.source || 'OTHER').toUpperCase(),
            priority,
            status: priority,
            pipelineStatus,
            score: null,
            time: lead.created_at
              ? new Date(lead.created_at).toLocaleString()
              : 'â€”',
            initials:
              name
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map((part) => part[0])
                .join('')
                .toUpperCase() || 'LD',
          }
        })

        if (!cancelled) {
          setLeads(mappedLeads)
        }
      } catch (error) {
        if (!cancelled) {
          if (error.response?.status === 401) {
            setLeadsError(
              'Your session has expired. Please sign in again.',
            )
          } else {
            setLeadsError(
              'Could not load leads. Confirm Django is running and your account has API access.',
            )
          }
        }
      } finally {
        if (!cancelled) {
          setLeadsLoading(false)
        }
      }
    }

    loadLeads()

    return () => {
      cancelled = true
    }
  }, [user, refreshKey, isPasswordResetPage])

  function handleLogout() {
    localStorage.removeItem('access_token')
    localStorage.removeItem('refresh_token')

    setUser(null)
    setLeads([])
    setActivePage('Overview')
    setQuery('')
    setFilter('All')
    setLeadsError('')
  }

  function handleLoginSuccess(loggedInUser) {
    setUser(loggedInUser)
    setRefreshKey((current) => current + 1)
  }

  function handleRetry() {
  setRefreshKey((current) => current + 1)
  setGlobalRefreshKey((current) => current + 1)
}

  function openLeads() {
    setActivePage('Leads')
    setMobileMenu(false)
  }

  function resetLeadFilters() {
    setQuery('')
    setFilter('All')
  }

  // Always show Login.jsx on the reset URL, even if already signed in.
  if (isPasswordResetPage) {
    return <Login onLogin={handleLoginSuccess} />
  }

  if (authLoading) {
    return <LoadingScreen />
  }

  if (!user) {
    return <Login onLogin={handleLoginSuccess} />
  }

  const displayName =
    user.first_name || user.username || user.email || 'User'

  const dashboardStats = [
    {
      title: 'Total Leads',
      value: leads.length.toLocaleString(),
      change: 'From database',
      icon: 'users',
    },
    {
      title: 'Qualified Leads',
      value: leads
        .filter((lead) =>
          ['QUALIFIED', 'PROPOSAL', 'NEGOTIATION', 'WON'].includes(
            lead.pipelineStatus,
          ),
        )
        .length.toLocaleString(),
      change: 'Qualified pipeline',
      icon: 'target',
    },
    {
      title: 'Hot Leads',
      value: leads
        .filter((lead) => lead.priority === 'HOT')
        .length.toLocaleString(),
      change: 'High priority',
      icon: 'flame',
    },
    {
      title: 'Won Leads',
      value: leads
        .filter((lead) => lead.pipelineStatus === 'WON')
        .length.toLocaleString(),
      change: 'Successfully won',
      icon: 'trophy',
    },
  ]

  const chartLeads = leads.map((lead) => ({
    ...lead,
    status: lead.pipelineStatus,
  }))

  return (
    <div className="min-h-screen bg-[#090d16] text-slate-100">
      <Sidebar
        activePage={activePage}
        setActivePage={setActivePage}
        mobileMenu={mobileMenu}
        setMobileMenu={setMobileMenu}
        user={user}
        onLogout={handleLogout}
      />

      <div className="min-h-screen lg:pl-[260px]">
        <Topbar
          activePage={activePage}
          setActivePage={setActivePage}
          setMobileMenu={setMobileMenu}
          user={user}
          leads={leads}
          onLogout={handleLogout}
        />

        <main className="mx-auto max-w-[1600px] px-4 py-6 sm:px-6 lg:px-8">
          <div className="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div>
              <p className="text-xs text-slate-500">
                Welcome back, {displayName}
              </p>
              <h1 className="mt-1 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
                {activePage}
              </h1>
              <p className="mt-2 text-sm text-slate-400">
                {activePage === 'AI Assistant'
                  ? 'Set up your assistantâ€™s personality, instructions and customer responses.'
                  : activePage === 'Settings'
                    ? 'Manage your profile and account preferences.'
                    : 'Manage your leads and keep your sales pipeline moving.'}
              </p>
            </div>

            {activePage === 'Overview' && (
              <div className="flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  onClick={handleRetry}
                  disabled={leadsLoading}
                  className="inline-flex items-center gap-2 rounded-xl border border-white/10 px-3 py-2.5 text-xs text-slate-300 transition hover:bg-white/[0.04] disabled:opacity-50"
                >
                  <RefreshCw
                    size={14}
                    className={leadsLoading ? 'animate-spin' : ''}
                  />
                  Refresh
                </button>

                <button
                  type="button"
                  onClick={openLeads}
                  className="inline-flex items-center gap-2 rounded-xl bg-violet-500 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-violet-400"
                >
                  <Plus size={15} />
                  View leads
                </button>
              </div>
            )}
          </div>

          <ErrorMessage message={leadsError} onRetry={handleRetry} />

          {activePage === 'Overview' && (
            <>
              <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {dashboardStats.map((stat) => (
                  <StatCard key={stat.title} {...stat} />
                ))}
              </div>

              <div className="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-3">
                <div className="min-w-0 xl:col-span-2">
                  <SalesChart leads={chartLeads} />
                </div>

                <div className="min-w-0">
                  <LeadQualification
                    leads={leads}
                    onViewLeads={openLeads}
                  />
                </div>
              </div>

              <LeadTable
                leads={leads}
                query={query}
                setQuery={setQuery}
                filter={filter}
                setFilter={setFilter}
                onViewAll={openLeads}
                onLeadsChanged={handleRetry}
              />

              {leadsLoading && (
                <p className="mt-3 text-xs text-slate-500">
                  Syncing leads from your Django backend...
                </p>
              )}

              {!leadsLoading && !leadsError && leads.length === 0 && (
                <p className="mt-3 text-xs text-slate-500">
                  No leads found yet. Add a lead to see it here.
                </p>
              )}
            </>
          )}

          {activePage === 'Leads' && (
            <section>
              <div className="mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
                <div>
                  <h2 className="text-base font-semibold text-white">
                    Lead management
                  </h2>
                  <p className="mt-1 text-xs text-slate-500">
                    {leads.length} leads available in your account
                  </p>
                </div>

                <button
                  type="button"
                  onClick={resetLeadFilters}
                  className="rounded-xl border border-white/10 px-3 py-2 text-xs text-slate-300 transition hover:bg-white/[0.04]"
                >
                  Clear filters
                </button>
              </div>

              <LeadTable
                leads={leads}
                query={query}
                setQuery={setQuery}
                filter={filter}
                setFilter={setFilter}
                onViewAll={openLeads}
                onLeadsChanged={handleRetry}
              />

              {leadsLoading && (
                <p className="mt-3 text-xs text-slate-500">
                  Loading leads...
                </p>
              )}

              {!leadsLoading && !leadsError && leads.length === 0 && (
                <p className="mt-3 text-xs text-slate-500">
                  No leads found. Add your first lead to get started.
                </p>
              )}
            </section>
          )}

          {activePage === 'Analytics' && <Reports refreshKey={globalRefreshKey} />}

          {activePage === 'Appointments' && <Appointments refreshKey={globalRefreshKey} />}

          {activePage === 'Quotations' && <Quotations refreshKey={globalRefreshKey} />}

          {activePage === 'Follow-ups' && (
            <FollowUps refreshKey={globalRefreshKey} onChanged={handleRetry} />
          )}

          {activePage === 'AI Conversations' && (
            <AIConversations refreshKey={globalRefreshKey} onChanged={handleRetry} />
          )}

          {activePage === 'AI Assistant' && <AIAssistant />}

          {activePage === 'Settings' && (
            <Settings
              user={user}
              onProfileUpdated={(updatedUser) =>
                setUser((currentUser) => ({
                  ...currentUser,
                  ...updatedUser,
                }))
              }
              onPasswordChanged={handleLogout}
            />
          )}
          {![
            'Overview',
            'Leads',
            'Quotations',
            'Appointments',
            'Follow-ups',
            'AI Conversations',
            'AI Assistant',
            'Analytics',
            'Settings',
          ].includes(activePage) && (
              <section className="rounded-2xl border border-white/[0.07] bg-[#0e1320] p-6 sm:p-8">
                <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-400/10 text-violet-300">
                  <Sparkles size={22} />
                </div>
                <h2 className="mt-4 text-lg font-semibold text-white">
                  {activePage}
                </h2>
                <p className="mt-2 max-w-xl text-sm leading-6 text-slate-400">
                  This workspace section is ready for its feature integration.
                  Your sign-in and lead data connection remain available.
                </p>
                <button
                  type="button"
                  onClick={openLeads}
                  className="mt-5 rounded-xl bg-violet-500 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-violet-400"
                >
                  Open lead management
                </button>
              </section>
            )}

          <footer className="mt-10 flex flex-col justify-between gap-3 border-t border-white/[0.06] py-5 text-[11px] text-slate-600 sm:flex-row sm:items-center">
            <span>Â© 2026 AIWEBSOUL.</span>
            <button
              type="button"
              onClick={handleLogout}
              className="inline-flex items-center gap-2 self-start transition hover:text-slate-300 sm:self-auto"
            >
              <LogOut size={13} />
              Sign out
            </button>
          </footer>
        </main>
      </div>
    </div>
  )
}

